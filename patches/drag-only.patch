--- a/src/evdev-mt-touchpad-gestures.c
+++ b/src/evdev-mt-touchpad-gestures.c
@@ -1888,6 +1888,15 @@
 static void
 tp_gesture_handle_state_3fg_drag_or_swipe_start(struct tp_dispatch *tp, usec_t time)
 {
+	/* Local preference: three-finger dragging must not turn into a swipe
+	 * based on movement speed. Start dragging before any swipe event is
+	 * emitted; retain the upstream behavior for four-finger dragging.
+	 */
+	if (tp->drag_3fg.nfingers == 3 && tp->gesture.finger_count == 3) {
+		tp->gesture.state = GESTURE_STATE_3FG_DRAG_START;
+		return;
+	}
+
 	const struct normalized_coords zero = { 0.0, 0.0 };
 	gesture_notify_swipe(&tp->device->base,
 			     time,
